# Forged in the Fire - Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://forgedinthefireohio.org
NEXT_PUBLIC_SITE_NAME=Forged in the Fire

# Supabase (Required for Blog, Admin, Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=bsalsbury@forgedinthefirellc.org
RESEND_TO_EMAIL=bsalsbury@forgedinthefirellc.org

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=forgedinthefireohio.org

# Security
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxx

# Hotlines & External Resources
NEXT_PUBLIC_HOTLINE_NATIONAL=1-888-373-7888
NEXT_PUBLIC_HOTLINE_SMS=233733

# Guest booth WebRTC (optional TURN). Leave unset for STUN-only.
# Set the same names on Netlify → Environment variables. Do not commit secrets.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Aliases also read: NETLIFY_TURN_URL, NETLIFY_TURN_USERNAME, NETLIFY_TURN_CREDENTIAL,
# NEXT_PUBLIC_TURN_URL, NEXT_PUBLIC_TURN_USERNAME, NEXT_PUBLIC_TURN_CREDENTIAL.
# TURN_SECRET is preferred over a static username and credential (short-lived REST creds).
# TURN_TTL_SECONDS=7200

# Podcast enterprise checklist. Leave commented until that service is provisioned.
# Set the same names on Netlify (and GitHub Actions for CRON_SECRET). Never commit values.
#
# Hourly publish + retention. Required for scheduled episodes to go live.
# CRON_SECRET=
#
# Guest booth TURN. Either TURN_SECRET, or TURN_USERNAME + TURN_CREDENTIAL.
# TURN_SECRET=
#
# Panel shows (2 or more guests). All three are required together.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# Hosted live ingest. The host browser still encodes; these point at WHIP / playback.
# LIVE_WHIP_URL=
# LIVE_WHIP_BEARER=
# LIVE_PLAYBACK_HLS_URL=
# LIVE_PLAYBACK_WHEP_URL=
# LIVE_WHIP_SEAL_SECRET=
#
# Cloudflare Stream simulcast. CLOUDFLARE_API_TOKEN is accepted if STREAM_API_TOKEN is unset.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_API_TOKEN=
# LIVE_CF_INPUT_ID=
# LIVE_DESTINATION_SECRET=
#
# Live chat. Falls back to the service role key when unset. Do not put raw IPs here.
# LIVE_CHAT_SALT=
# CHAT_EXTRA_BLOCKLIST=
#
# Directory refresh after a publish. Optional.
# PODPING_TOKEN=
# PODPING_URL=https://podping.cloud/
# WEBSUB_HUB=
#
# Salt for hashing consent IPs. Falls back to part of the service role key.
# CONSENT_IP_SALT=
#
# Optional Tus endpoint for large guest-take uploads.
# SUPABASE_STORAGE_TUS_URL=
#
# The public `media` bucket is created by hand in Supabase Storage, not by a migration.
# `podcast-guest-takes` and `podcast-private` are created by podcast migrations.
