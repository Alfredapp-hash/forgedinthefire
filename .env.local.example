# Forged in the Fire - Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://forgedinthefireohio.org
NEXT_PUBLIC_SITE_NAME=Forged in the Fire

# Supabase (Required for Blog, Admin, Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=bsalsbury@forgedinthefirellc.org
RESEND_TO_EMAIL=bsalsbury@forgedinthefirellc.org

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=forgedinthefireohio.org

# Security
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxx

# Hotlines & External Resources
NEXT_PUBLIC_HOTLINE_NATIONAL=1-888-373-7888
NEXT_PUBLIC_HOTLINE_SMS=233733

# Guest booth WebRTC (optional TURN). Leave unset for STUN-only.
# Set the same names on Netlify → Environment variables. Do not commit secrets.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Aliases also read: NETLIFY_TURN_URL, NETLIFY_TURN_USERNAME, NETLIFY_TURN_CREDENTIAL

# Live shows (WHIP ingest from the browser control room). All server-side only.
# See docs/podcast-live.md. If LIVE_WHIP_URL is unset, the admin Live tab reports "not configured".
# LIVE_WHIP_URL: provider WHIP endpoint. Cloudflare Stream: the live input's "WebRTC (WHIP)" URL,
#   e.g. https://customer-<code>.cloudflarestream.com/<secret>/webRTC/publish  (the URL itself is the secret)
#   MediaMTX: https://live.example.org/<path>/whip   LiveKit ingress: https://<project>.livekit.cloud/w
# LIVE_WHIP_URL=
# LIVE_WHIP_BEARER: optional. Sent as "Authorization: Bearer <value>" (LiveKit stream key, MediaMTX JWT).
#   A value that already starts with "Basic " or "Bearer " is sent verbatim (MediaMTX internal users).
# LIVE_WHIP_BEARER=
# Default public playback for sessions without their own URLs (these are public, not secrets):
# LIVE_PLAYBACK_HLS_URL=https://customer-<code>.cloudflarestream.com/<input-uid>/manifest/video.m3u8
# LIVE_PLAYBACK_WHEP_URL=https://customer-<code>.cloudflarestream.com/<input-uid>/webRTC/play
# Optional: key material for sealing WHIP resource URLs handed to the browser (defaults to the service role key).
# LIVE_WHIP_SEAL_SECRET=
